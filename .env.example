# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Your numeric Telegram chat ID — message @userinfobot to get it.
# The bot ignores every other ID. Leave as 0 and the bot rejects everyone.
ALLOWED_CHAT_ID=000000000

# --- Trust Bank email ingestion (optional) ---
# Leave GMAIL_APP_PASSWORD empty to disable the email poll entirely.
# Needs 2-Step Verification ON, then an App Password (Google Account >
# Security > App passwords). Use the 16 chars with no spaces.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# How often to poll Gmail for new Trust alerts (minutes).
EMAIL_POLL_MINUTES=15

# --- Tiger Brokers Open API (portfolio page, optional) ---
# Leave TIGER_ID empty to disable the portfolio feature entirely.
# Register at https://developer.tigerbrokers.com.sg/ to get these, then save
# the RSA private key to the host dir you mount at /app/data (see compose.yaml).
TIGER_ID=
TIGER_ACCOUNT=
TIGER_PRIVATE_KEY_PATH=/app/data/tiger_private_key.pem
# How often to poll Tiger for holdings (minutes). Set 0 for manual-only —
# the dashboard's refresh button still works, nothing polls on a timer.
PORTFOLIO_POLL_MINUTES=30

# --- Payslip archive (optional) ---
# If your employer mails you a password-protected payslip PDF each month, the
# same Gmail poll can archive and parse it. Leave BOTH of these empty to
# disable the feature entirely -- no payslip mail is opened, no PDF is stored,
# and the Pay tab stays hidden. Env changes need Stop -> Start, not Restart.
#
# The password the provider puts on the PDF (often a fixed prefix plus your
# date of birth). It is read from env only -- never sent over the wire.
PAYSLIP_PDF_PASSWORD=
# The address the payslip arrives from. Payslips are matched on sender + a PDF
# attachment, never on subject -- payroll subjects tend to carry a per-request
# number, not the pay month (which is read out of the document itself).
PAYSLIP_SENDER=
PAYSLIP_DIR=/app/data/payslips

# --- Web dashboard login ---
# Signup is open only while zero accounts exist. Set SIGNUP_CODE to reopen it;
# when set, the code is required for EVERY signup, including the first.
# Env changes need Stop -> Start (recreation), not Restart.
SIGNUP_CODE=
# Comma-separated peer IPs whose X-Forwarded-For is trusted. Leave empty unless
# you know the proxy's address -- requests arrive via Nginx Proxy Manager, so
# empty means every visitor shares one throttle window (the per-username window
# still applies). Trusting XFF blindly would let direct hits on :8085 spoof it.
TRUSTED_PROXIES=

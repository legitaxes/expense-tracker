# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Your numeric Telegram chat ID — message @userinfobot to get it.
# The bot ignores every other ID. Leave as 0 and the bot rejects everyone.
ALLOWED_CHAT_ID=000000000

# --- Trust Bank email ingestion (optional) ---
# Leave GMAIL_APP_PASSWORD empty to disable the email poll entirely.
# Needs 2-Step Verification ON, then an App Password (Google Account >
# Security > App passwords). Use the 16 chars with no spaces.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# How often to poll Gmail for new Trust alerts (minutes).
EMAIL_POLL_MINUTES=15
